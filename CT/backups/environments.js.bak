// The single place an environment is declared. Adding one used to mean editing
// three files that had no way to check each other: a label in `app.js`, an HDR
// url plus a four-row rig table in `cube-realistic.js`, and a literal path in
// the server's allowlist. Nothing failed loudly when they drifted — a missing
// server entry served a 404 the renderer swallowed into its studio fallback, so
// the environment simply looked wrong instead of looking broken.
//
// Now an environment is one entry here. The renderer reads `file` for the HDR
// and `envScale` for its calibration, the appearance selector reads `label` and
// `detail`, and the server serves any `assets/*.hdr` by name, so it needs no
// entry at all. Dropping an HDR into `assets/` and adding a line below is the
// whole procedure.

/* Loaded as a classic script, like core.js, because app.js is not a module. */
(function (root) {
  "use strict";
  // How the per-environment light scale is derived when an entry does not state
  // one. Each HDR's solid-angle-weighted mean luminance says how much dimmer or
  // brighter its sky is than the photograph the photographic rig was tuned
  // against; `REFERENCE_LUMINANCE` is that photograph's reading. Compensating for
  // the ratio in full would put identical light on the cube from every
  // environment, which is the same as having one environment, so the compensation
  // is the square root of the ratio: a dim room still renders a dimmer cube, a
  // sunset still renders a brighter one, and the difference between rooms
  // survives at about half strength.
  //
  // The cap is for the mirror. `uv` multiplies this scale again against a
  // near-mirror clearcoat, and an uncapped dim-but-contrasty room turns a handful
  // of hot windows into a handful of strobes swept across the coat. The floor is
  // the same guard pointing down: an environment cannot be dimmed into a cube
  // lit only by the rig's own lamps, which would make the photograph decorative.
  const REFERENCE_LUMINANCE = 1.128;
  const SCALE_CAP = 1.8;
  const SCALE_FLOOR = .35;

  // Values saved from the lighting studio live here as source-controlled data,
  // not in browser storage. The local server only rewrites the JSON between
  // these markers after an explicit confirmation in the UI. Entries are keyed
  // by environment and then by cube model; an absent entry inherits the
  // renderer's carefully balanced studio/photographic default.
  const TUNING = /* cube-tuning:start */ {
  "studioSmall08": {
    "uv": {
      "exposure": 0.882,
      "hemi": 0.85,
      "key": 2.2,
      "rim": 0.72,
      "fill": 1.1,
      "env": 0.22,
      "gloss": 0.88,
      "glossRough": 0.07
    },
    "speedcube": {
      "exposure": 0.44,
      "hemi": 0.55,
      "key": 1.4,
      "rim": 0.68,
      "fill": 0.7,
      "env": 0.76,
      "gloss": 0.49,
      "glossRough": 0.5
    },
    "tiles": {
      "exposure": 0.55,
      "hemi": 0.78,
      "key": 1.47,
      "rim": 1.46,
      "fill": 0.93,
      "env": 0.68,
      "gloss": 0.31,
      "glossRough": 0.03
    }
  },
  "studio": {
    "uv": {
      "exposure": 0.84,
      "hemi": 0.72,
      "key": 2.1,
      "rim": 0.72,
      "fill": 1.05,
      "env": 0.595,
      "gloss": 0.3,
      "glossRough": 0.1093
    },
    "tiles": {
      "exposure": 0.53,
      "hemi": 0.58,
      "key": 1.02,
      "rim": 1.05,
      "fill": 0.8,
      "env": 1.09,
      "gloss": 0.81,
      "glossRough": 0.235
    }
  },
  "clinic": {
    "tiles": {
      "exposure": 0.61,
      "hemi": 0.7,
      "key": 1.1,
      "rim": 1.05,
      "fill": 0.85,
      "env": 1.27,
      "gloss": 0.22,
      "glossRough": 0.11
    }
  },
  "fireplace": {
    "uv": {
      "exposure": 0.75,
      "hemi": 0.6,
      "key": 2.2,
      "rim": 0.72,
      "fill": 0.62,
      "env": 1.02,
      "gloss": 0.51,
      "glossRough": 0.05
    }
  },
  "duotone": {
    "uv": {
      "exposure": 0.72,
      "hemi": 1.1,
      "key": 2.2,
      "rim": 0.72,
      "fill": 1.1,
      "env": 1.02,
      "gloss": 0.83,
      "glossRough": 0.04
    }
  }
} /* cube-tuning:end */;

  // `envScale` is an override, and it is only correct to write one after looking
  // at a render. The measurement predicts the two gelled studios badly, and in a
  // specific way worth recording: their light is two large softboxes aimed at the
  // middle of the room, so far more of it reaches the cube than a mean over the
  // whole sphere suggests, and it arrives as one saturated colour. ACES compresses
  // the dominant channel of a saturated colour long before the other two, so the
  // surplus lands on screen as chalky pastel rather than as glare — the cap stops
  // being the palette's colour, which is the one thing the exposure budget exists
  // to prevent. At the measured scale the front face went pink. The numbers below
  // were set by rendering `tiles` at Balanced, same scramble and same orbit, and
  // reading the cap pixels.
  //
  // Everything without an override is measured at load. Cross-checked against the
  // hand-tuned values these replace: cabin 1.41 (was 1.41), clinic 1.27 (1.27),
  // fireplace 1.80 at the cap (1.80), sunset .71 (.75). Sunset is the one whose
  // light arrives from a single direction, and the formula handles it — what
  // makes a warm cap bright there is the rig's own key, not the photograph.
  const ENVIRONMENTS = {
  studio: {
    label: "Studio",
    detail: "Generated softboxes · bright and clean",
    // No file: the studio is the luminous-card room the renderer builds in code,
    // and it is the rig the other entries are photographs against.
    generated: true,
  },
  cabin: {
    file: "cabin_1k.hdr",
    label: "Ship's cabin",
    detail: "Lamplit wood · close and warm",
  },
  fireplace: {
    file: "fireplace_1k.hdr",
    label: "Fireplace",
    detail: "Ochre walls · dim and very warm",
  },
  clinic: {
    file: "hospital_room_2_1k.hdr",
    label: "Clinic",
    detail: "White ward · cool, even daylight",
  },
  magenta: {
    file: "ferndale_studio_05_1k.hdr",
    label: "Magenta studio",
    detail: "Gelled softboxes · one strong color",
    // Measured .287, which asks for 1.98. At that scale the cap clips a channel
    // and reads pink rather than red.
    envScale: .50,
  },
  duotone: {
    file: "ferndale_studio_10_1k.hdr",
    label: "Duotone studio",
    detail: "Magenta key against a teal floor",
    // Same failure as magenta, softer: measured .511, asks for 1.49.
    envScale: .90,
  },
  sunset: {
    file: "kiara_8_sunset_1k.hdr",
    label: "Desert sunset",
    detail: "Open sky · low sun, long shadows",
  },
  ferndale04: {
    file: "ferndale_studio_04_4k.hdr",
    label: "Ferndale studio 04",
    detail: "Soft neutral light · broad softboxes",
  },
  ferndale12: {
    file: "ferndale_studio_12_4k.hdr",
    label: "Ferndale studio 12",
    detail: "Broad neutral light · cool cast",
  },
  heritage: {
    file: "ladybrand_heritage_house_4k.hdr",
    label: "Heritage house",
    detail: "Historic interior · warm windows",
  },
  nqweba: {
    file: "nqweba_dawn_4k.hdr",
    label: "Nqweba dawn",
    detail: "Cool early light · open and even",
  },
  studioSmall08: {
    file: "studio_small_08_4k.hdr",
    label: "Studio small 08",
    detail: "Compact softboxes · near neutral",
  },
  };

  // Both consumers want the same order the object is written in, so neither has
  // to keep a list of ids beside the manifest.
  root.CT_ENVIRONMENTS = { ENVIRONMENTS, TUNING, REFERENCE_LUMINANCE, SCALE_CAP, SCALE_FLOOR, IDS: Object.keys(ENVIRONMENTS) };
  })(window);
